generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum AdminType {
  PLANNING
  DEV
}

enum ProjectStatus {
  UNASSIGNED
  IN_PROGRESS
  DONE
}

enum Position {
  FE
  BE
  AI
  PM
  ETC
}

enum InquiryKind {
  QUESTION
  SUGGESTION
  BUG
}

enum PlanDocKind {
  FILE
  LINK
}

enum ExpenseKind {
  SPENT
  PLANNED
}

enum SkillLevel {
  BEGINNER
  NOVICE
  INTERMEDIATE
  ADVANCED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  name         String
  role         Role       @default(MEMBER)
  adminType    AdminType?
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  /// 디스코드 사용자 ID. 문의 답변 알림에서 본인을 언급할 때 쓴다 (본인이 /settings에서 입력)
  discordId    String?

  // 역량 프로필 (본인이 /settings에서 작성, 운영진이 열람)
  level     SkillLevel?
  tools     String?
  skills    String?
  interests String?
  bio       String?

  /// 운영진이 판단해 지정하는 수준. 본인이 쓰는 level 과 별도로 둬서 서로 덮지 않는다
  adminLevel SkillLevel?

  /// 본인이 고른 선호 포지션. 실제 배치 포지션(ProjectMember.position)과는 별개
  preferredPosition Position?

  /// 공지 페이지를 마지막으로 연 시각. 이후에 올라온 공지 수가 사이드바 숫자. null이면 전부 미확인
  noticesSeenAt DateTime?

  memberships      ProjectMember[]
  createdFeatures  Feature[]       @relation("FeatureCreatedBy")
  weeklyUpdates    WeeklyUpdate[]
  uploadedPlanDocs PlanDoc[]
  questions        Question[]      @relation("QuestionAuthor")
  answers          Question[]      @relation("QuestionAnsweredBy")
  profileLinks     ProfileLink[]
  reportNotes      ReportNote[]
  inquiries        Inquiry[]       @relation("InquiryAuthor")
  inquiryAnswers   Inquiry[]       @relation("InquiryAnsweredBy")
  inquiryReplies   InquiryReply[]
  expenses         ExpenseClaim[]
  notices          Notice[]
  meetingMinutes   MeetingMinute[]
  meetingNotes     MeetingNote[]
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique
  category     String
  priority     String
  dueDate      DateTime?
  title        String
  summary      String
  description  String
  status       ProjectStatus @default(UNASSIGNED)
  /// 운영진이 지정한 주요 프로젝트. 대시보드·주간 보고에서 맨 위에 보인다
  featured     Boolean       @default(false)
  githubUrl    String?
  deployUrl    String?
  mainLanguage String?
  infraNote    String?
  startedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members       ProjectMember[]
  features      Feature[]
  weeklyUpdates WeeklyUpdate[]
  planDocs      PlanDoc[]
  questions     Question[]
}

model ProjectMember {
  projectId  String
  userId     String
  position   Position @default(ETC)
  isLead     Boolean  @default(false)
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Feature {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  done        Boolean  @default(false)
  order       Int
  createdById String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("FeatureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model WeeklyUpdate {
  id           String   @id @default(cuid())
  projectId    String
  authorId     String
  weekStart    DateTime @db.Date
  didThisWeek  String
  planNextWeek String
  issues       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekStart])
}

/**
 * 개인 포트폴리오·이력서 링크 또는 업로드 파일
 */
model ProfileLink {
  id        String      @id @default(cuid())
  userId    String
  title     String
  kind      PlanDocKind
  url       String
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * 주차별 운영진 총평·특이사항. 한 주에 하나
 */
model ReportNote {
  weekStart DateTime @id @db.Date
  authorId  String
  content   String
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PlanDoc {
  id           String      @id @default(cuid())
  projectId    String
  title        String
  kind         PlanDocKind
  url          String
  uploadedById String
  createdAt    DateTime    @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/**
 * 사이트 자체에 대한 문의·건의. 프로젝트와 무관하며 운영진·부원 모두 남길 수 있다
 */
model Inquiry {
  id           String      @id @default(cuid())
  authorId     String
  kind         InquiryKind @default(QUESTION)
  content      String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime    @default(now())

  author     User           @relation("InquiryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answeredBy User?          @relation("InquiryAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  replies    InquiryReply[]

  @@index([createdAt])
}

/**
 * 첫 답변 이후 운영진·작성자가 이어 다는 답글
 */
model InquiryReply {
  id        String   @id @default(cuid())
  inquiryId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

/**
 * 개인 비용 청구 한 건. 여러 건을 한 달에 나눠 등록한다
 */
model ExpenseClaim {
  id         String      @id @default(cuid())
  userId     String
  /// 청구 대상 월. "YYYY-MM"
  month      String
  kind       ExpenseKind @default(SPENT)
  title      String
  amount     Int
  note       String?
  receiptUrl String?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([month])
  @@index([userId])
}

model Question {
  id              String    @id @default(cuid())
  projectId       String
  authorId        String
  content         String
  /// 비공개 질문은 작성자와 운영진만 내용을 볼 수 있다
  isPrivate       Boolean   @default(false)
  answer          String?
  answeredById    String?
  answeredAt      DateTime?
  sentToDiscordAt DateTime?
  createdAt       DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User    @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answeredBy User?   @relation("QuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sentToDiscordAt])
}

/// 운영진이 올리는 전체 공지. 부원은 읽기만 한다
model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// 운영진이 올리는 주간 회의록 링크(구글 독스 등). 부원은 읽기만 한다
model MeetingMinute {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String
  fileUrl   String
  authorId  String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([date])
}

/// 회의록 생성 때 운영진이 적은 자유 메모. 회의 날짜당 하나, 다시 생성하면 덮어쓴다
model MeetingNote {
  date      DateTime @id @db.Date
  notes     String
  authorId  String
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
